<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Lets the app list apps that have a launcher icon, for the "apps to watch" picker. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <!-- Bound by the system once the user grants Notification access; no other app can bind it. -->
    <service
      android:name="expo.modules.smsreader.FinanceNotificationListener"
      android:exported="true"
      android:label="Expense AI"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
