{
  "expo": {
    "name": "Expense AI",
    "slug": "expense-ai",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expenseai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "dev.expensetracker.ai",
      "infoPlist": {}
    },
    "android": {
      "package": "dev.expensetracker.ai",
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.READ_SMS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E3F3CF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "versionCode": 3
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B3A33",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "./plugins/with-gradle-memory",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Expense AI uses the camera to read receipts."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0c4f0fdf-38d0-4b13-af68-bc361f2fd195"
      }
    },
    "owner": "adarshagupta",
    "updates": {
      "url": "https://u.expo.dev/0c4f0fdf-38d0-4b13-af68-bc361f2fd195",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 10000
    }
  }
}
